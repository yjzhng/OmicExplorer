{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["electron-vite/node"],
    "noEmit": true
  },
  "include": [
    "../src/main/**/*",
    "../src/preload/**/*",
    "../electron.vite.config.ts",
    "../config/citation.ts",
    "../config/releaseBody.ts",
    "../scripts/release-body.ts",
    "../package.json"
  ],
  "exclude": ["../src/**/*.test.ts"]
}
