{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.web.tsbuildinfo",
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": "..",
    "paths": {
      "@renderer/*": ["src/renderer/src/*"]
    },
    "noEmit": true
  },
  "include": ["../src/renderer/src/**/*", "../src/preload/*.d.ts"],
  "exclude": ["../src/**/*.test.ts"]
}
